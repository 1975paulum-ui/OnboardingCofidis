# Clave de API de Namirial Onboarding (entorno de test)
NAMIRIAL_API_KEY=
NAMIRIAL_BASE_URL=https://test-eu-ie1-api.namirialonboarding.com/api/v2

# URL pública de la demo en Render (sin barra final)
PUBLIC_URL=https://cofidis-onboarding-demo.onrender.com

# requestTypeId de cada botón (ya vienen por defecto en server.js; solo para sobrescribirlos)
# REQUEST_TYPE_IDSELF=3673aa11-3cf8-4fc9-9e3e-1ab22d2d4b41
# REQUEST_TYPE_IDSELF_SIGN=fec0f3fe-60ac-46f2-a98e-1d457dab49cc
# REQUEST_TYPE_IDDOCCHECK=c54da3e2-4326-4ea5-811c-4f57b5214e65

# Opcional: protege la web con usuario y clave
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Opcional: cabecera secreta que Namirial enviará en los webhooks
WEBHOOK_AUTH_HEADER=x-webhook-secret
WEBHOOK_AUTH_VALUE=

# Flujo con firma (ID SELF + SIGN): contacto del firmante. Recibirá los códigos de verificación.
DEMO_EMAIL=
DEMO_PHONE_NUMBER=

# Idioma del asistente de identificación (parámetro `language` de POST /requests). Por defecto: fr
NAMIRIAL_LANGUAGE=fr
